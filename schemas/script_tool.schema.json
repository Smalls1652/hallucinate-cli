{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScriptToolDefinition",
  "description": "A parsed TOML definition for a script tool.",
  "type": "object",
  "properties": {
    "command": {
      "description": "Shell command to execute.",
      "type": "string"
    },
    "description": {
      "description": "Human-readable description of what the tool does.",
      "type": "string"
    },
    "max_result_bytes": {
      "description": "Maximum bytes included in a returned tool result.",
      "type": "integer",
      "format": "uint",
      "default": 100000,
      "minimum": 0
    },
    "parameters": {
      "description": "Named parameters accepted by the tool.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ScriptToolParameter"
      }
    },
    "shell": {
      "description": "Optional shell override (e.g. `[\"bash\", \"-c\"]`).",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "timeout": {
      "description": "Maximum execution time in seconds. Defaults to the configured shell\ntimeout.",
      "type": "integer",
      "format": "uint64",
      "default": 60,
      "minimum": 0
    }
  },
  "required": [
    "command",
    "description"
  ],
  "$defs": {
    "ScriptToolParameter": {
      "description": "A single parameter definition for a script tool.",
      "type": "object",
      "properties": {
        "constraints": {
          "description": "Optional constraints enforced for values supplied to this parameter.",
          "anyOf": [
            {
              "$ref": "#/$defs/ScriptToolParameterConstraints"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "description": "Description of the parameter.",
          "type": "string"
        },
        "input_type": {
          "description": "JSON schema type for the parameter (e.g. \"string\", \"int\", \"bool\").",
          "$ref": "#/$defs/ScriptToolParameterInputType"
        },
        "required": {
          "description": "Whether this parameter is required.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "description"
      ]
    },
    "ScriptToolParameterConstraints": {
      "description": "Value constraints for a script tool parameter.",
      "type": "object",
      "properties": {
        "enum": {
          "description": "Values accepted by the parameter.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": true
        },
        "maximum": {
          "description": "Inclusive upper bound for numeric parameters.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "minimum": {
          "description": "Inclusive lower bound for numeric parameters.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        }
      }
    },
    "ScriptToolParameterInputType": {
      "description": "JSON schema types for a script tool parameter.",
      "oneOf": [
        {
          "description": "A string type.",
          "type": "string",
          "const": "string"
        },
        {
          "description": "An integer type.",
          "type": "string",
          "const": "int"
        },
        {
          "description": "A floating-point number type.",
          "type": "string",
          "const": "float"
        },
        {
          "description": "A boolean type.",
          "type": "string",
          "const": "bool"
        },
        {
          "description": "An array type.",
          "type": "string",
          "const": "array"
        },
        {
          "description": "An object type.",
          "type": "string",
          "const": "object"
        }
      ]
    }
  }
}
